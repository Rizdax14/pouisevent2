    {
      "source": "/insta-logic.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/foot-display.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/insta/*.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{fonts/**,assets/insta/**,insta-logic.js,foot-logic.js,node_modules/harfbuzzjs/**}"
